<!doctype html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register | VaultQ</title><link rel="stylesheet" href="css/auth.css"></head><body><div class="auth-wrap"><a class="back" href="/">← Back to VaultQ</a><div class="auth-card"><div class="brand-center"><div class="logo" style="display:flex;align-items:center;gap:10px;font-size:23px;font-weight:800"><span style="width:40px;height:40px;border-radius:11px;background:#39d98a;color:#04121b;display:grid;place-items:center;font-weight:900">V</span>VaultQ</div></div><h1>Create your account</h1><p class="sub">Start managing your finances with VaultQ.</p><form id="registerForm"><div class="form-group"><label>Full Name</label><input id="name" required></div><div class="form-group"><label>Email</label><input id="email" type="email" required></div><div class="form-group"><label>Password</label><input id="password" type="password" required></div><button class="btn primary" type="submit">Create Account</button><div id="authMessage" class="message"></div></form><div class="auth-foot">Already have an account? <a href="login.html">Login</a></div></div></div><script src="js/auth.js"></script></body></html>
