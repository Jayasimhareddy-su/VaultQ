PORT=3000
NODE_ENV=development
SESSION_SECRET=replace-with-a-long-random-secret

# Optional cloud AI. Leave blank to use local AI without any API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
OPENAI_STRICT=false

# Optional local LLM. If Ollama is installed and running, VaultQ AI will use it automatically.
# Default model is mistral.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=mistral
